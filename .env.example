# Copy to .env and `export $(grep -v '^#' .env | xargs)`.
# Every value is optional; defaults are safe.

# ---- shared ---------------------------------------------------------------
# Root for credentials, browser profiles, exports, run summaries, audit log.
# SOCIAL_CLEANER_DATA_DIR=~/.social-cleaner
# SOCIAL_CLEANER_LOG_LEVEL=INFO
# Append-only record of every destructive action. Keep it: nothing can be undone.
# SOCIAL_CLEANER_AUDIT_LOG_ENABLED=1
# SOCIAL_CLEANER_AUDIT_LOG_PATH=~/.social-cleaner/audit.jsonl

# ---- bilibili -------------------------------------------------------------
# Process-wide request cap. Raising it raises the chance of risk control (-352 / 412).
# BILI_API_QPS=1.5
# BILI_HTTP_TIMEOUT=10
# BILI_MAX_RETRIES=3
# BILI_RETRY_BASE_DELAY=1
# CLI credentials (set by `social-cleaner bilibili login`, or supply directly):
# BILI_CREDENTIALS_PATH=~/.social-cleaner/bilibili/credentials.json
# BILI_SESSDATA=
# BILI_JCT=

# ---- x --------------------------------------------------------------------
# false = always show the browser (default), true = never, auto = only for login.
# X_HEADLESS=false
# X_BROWSER_TYPE=chromium            # chromium | firefox | webkit
# X_BROWSER_CHANNEL=                 # e.g. chrome to use the installed Google Chrome
# X_USER_DATA_DIR=~/.social-cleaner/x/browser-data
# Keep one device profile per account; do not rotate fingerprints.
# X_VIEWPORT_WIDTH=1512
# X_VIEWPORT_HEIGHT=982
# X_DEVICE_SCALE_FACTOR=2
# X_LOCALE=zh-CN
# X_TIMEZONE_ID=Asia/Shanghai
# X_USER_AGENT=
# Optional automatic login. Manual login in the visible browser is recommended.
# X_USERNAME=
# X_PASSWORD=
# Refuse to run unless the logged-in account is this handle.
# X_TARGET_USERNAME=
# X_MANUAL_LOGIN_TIMEOUT_MINUTES=15
# X_START_COUNTDOWN_SECONDS=10
# X_CLOSE_WAIT_SECONDS=3
# X_FAIL_ON_ERRORS=0
# Override defaults / selectors without CLI flags:
# X_CONFIG_FILE=docs/x-config.example.json
# X_SELECTORS_FILE=
